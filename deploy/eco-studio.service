[Unit]
Description=ECO Label Studio web app
# network-online (not just network) so the TLS helper sees the DHCP address and
# puts it in the certificate on boot.
After=network-online.target lprint.service
Wants=network-online.target lprint.service
# Never give up restarting; RestartSteps/RestartMaxDelaySec below provide the backoff.
StartLimitIntervalSec=0

[Service]
Type=simple
User=eco-studio
Group=eco-studio
# Lets the app read the journal (journalctl) for its log viewer.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/eco-studio/current

# "+" runs the TLS helper as root outside the sandbox and user settings below,
# so it can create /var/lib/eco-studio/tls and chown it to eco-studio.
ExecStartPre=+/usr/local/sbin/eco-studio-tls
ExecStart=/usr/bin/node server/dist/main.js
# The server reloads its certificate and key on SIGHUP.
ExecReload=/bin/kill -HUP $MAINPID

Environment=NODE_ENV=production
Environment=ECO_DATA_DIR=/var/lib/eco-studio
Environment=ECO_TLS_DIR=/var/lib/eco-studio/tls
Environment=ECO_HTTP_PORT=80
Environment=ECO_HTTPS_PORT=443
Environment=ECO_STATIC_DIR=/opt/eco-studio/current/web/dist
Environment=ECO_CAPTURE_DIR=/var/spool/lprint-capture

# Bind ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StateDirectory=eco-studio
StateDirectoryMode=0750

Restart=always
RestartSec=2s
RestartSteps=8
RestartMaxDelaySec=5min
KillSignal=SIGTERM
# On SIGTERM the server waits up to 15s for in-flight prints before exiting.
TimeoutStopSec=30s

# Sandboxing.
# ProtectSystem=strict mounts the whole filesystem read-only for this service
# but leaves it readable, so /run/eco-printer-health, /proc and
# /sys/class/thermal can still be read. Only /var/lib/eco-studio and the LPrint
# page-capture directory (read and deleted after ingestion) are writable. The
# "-" prefix keeps the unit starting if the capture directory doesn't exist.
# journalctl works through membership in the systemd-journal group.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/eco-studio -/var/spool/lprint-capture

# The app restarts units and reboots the Pi by running systemctl. systemctl
# talks to PID 1 and logind over D-Bus (/run/dbus/system_bus_socket), and
# polkit authorizes the request based on the caller's UID (see
# /etc/polkit-1/rules.d/50-eco-studio.rules). No setuid binary and no
# in-process privilege gain is involved, so NoNewPrivileges does not break it.
# Connecting to a Unix socket is allowed on a read-only mount.
#
# Deliberately not set: PrivateDevices, ProtectKernelLogs, ProtectProc=invisible,
# SystemCallFilter, PrivateNetwork, IPAddressDeny, RestrictAddressFamilies.
# D-Bus and journalctl need AF_UNIX, os.networkInterfaces() needs AF_NETLINK,
# and nmcli needs D-Bus.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
# ProtectClock also implies DeviceAllow=char-rtc r, which limits device access
# to that plus the standard pseudo devices (/dev/null, /dev/urandom, ...). The
# app talks to the printer over IPP, not a device node, so that is fine.
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# MemoryDenyWriteExecute stays off: the V8 JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
