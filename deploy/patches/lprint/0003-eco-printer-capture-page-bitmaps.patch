+
+//
+// 'lprint_zpl_capture_close()' - Finish a page capture (eco-printer).
+//
+// Keeps the file only when every line of the page was written.
+//
+
+static void
+lprint_zpl_capture_close(
+    pappl_job_t  *job,			// I - Job
+    lprint_zpl_t *zpl)			// I - ZPL driver data
+{
+  bool	complete;			// Were all lines written?
+
+
+  if (!zpl->capture)
+    return;
+
+  complete = zpl->capture_lines == zpl->capture_height;
+
+  if (fclose(zpl->capture) || !complete || rename(zpl->capture_temp, zpl->capture_name))
+  {
+    if (complete)
+      papplLogJob(job, PAPPL_LOGLEVEL_WARN, "Unable to save page capture '%s': %s", zpl->capture_name, strerror(errno));
+
+    unlink(zpl->capture_temp);
+  }
+
+  zpl->capture = NULL;
+}
+
+
+//
+// 'lprint_zpl_capture_open()' - Start a page capture (eco-printer).
+//
+// Writes a binary PBM ("P4", 1 = black, rows padded to whole bytes) named
+// job-<id>-page-<n>.pbm, via a dotfile that is renamed when the page is done.
+// Does nothing when the capture directory does not exist.
+//
+
+static void
+lprint_zpl_capture_open(
+    pappl_job_t        *job,		// I - Job
+    pappl_pr_options_t *options,	// I - Job options
+    lprint_zpl_t       *zpl,		// I - ZPL driver data
+    unsigned           page)		// I - Page number (1-based)
+{
+  struct stat	info;			// Capture directory info
+  unsigned	width;			// Bitmap width in pixels
+
+
+  zpl->capture        = NULL;
+  zpl->capture_lines  = 0;
+  zpl->capture_height = options->header.cupsHeight;
+
+  if (stat(LPRINT_ZPL_CAPTURE_DIR, &info) || !S_ISDIR(info.st_mode))
+    return;
+
+  if ((width = options->header.cupsWidth) == 0 || (width + 7) / 8 != zpl->dither.out_width)
+    width = zpl->dither.out_width * 8;
+
+  snprintf(zpl->capture_name, sizeof(zpl->capture_name), "%s/job-%d-page-%u.pbm", LPRINT_ZPL_CAPTURE_DIR, papplJobGetID(job), page);
+  snprintf(zpl->capture_temp, sizeof(zpl->capture_temp), "%s/.job-%d-page-%u.pbm.tmp", LPRINT_ZPL_CAPTURE_DIR, papplJobGetID(job), page);
+
+  if ((zpl->capture = fopen(zpl->capture_temp, "wb")) == NULL)
+  {
+    papplLogJob(job, PAPPL_LOGLEVEL_WARN, "Unable to create page capture '%s': %s", zpl->capture_temp, strerror(errno));
+    return;
+  }
+
+  fprintf(zpl->capture, "P4\n%u %u\n", width, zpl->capture_height);
+}
